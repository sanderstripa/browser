{
  "manifest_version": 3,
  "name": "VPN",
  "version": "2.7.0",
  "description": "Private VPN proxy for Chrome powered by a local Xray helper.",
  "key": "",
  "permissions": ["nativeMessaging", "proxy", "storage", "privacy", "alarms"],
  "background": { "service_worker": "background.js" },
  "icons": { "16": "icons/icon-off-16.png", "32": "icons/icon-off-32.png", "48": "icons/icon-off-48.png", "128": "icons/icon-off-128.png" },
